<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Ferry</AssemblyName>
    <RootNamespace>Ferry.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ferry.ico</ApplicationIcon>
    <!-- WPF's Fluent theme (ThemeMode) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <Description>Ferry: move files, settings and programs from your old PC to your new one.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ferry.Core\Ferry.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ferry.ico" />
  </ItemGroup>

</Project>
