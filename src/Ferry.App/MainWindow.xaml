<Window x:Class="Ferry.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ferry" Width="1180" Height="780" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="Assets/ferry.ico">
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: brand, where you are, and the admin warning. -->
        <Border Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,24,16,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,30">
                    <Image Source="Assets/ferry.ico" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Ferry" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Move to a new PC" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource WarningBar}" Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVisibility}}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="14" Margin="0,1,8,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                <TextBlock Grid.Column="1" Text="Not running as administrator" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,8"
                                       Text="Only your own account can be moved, and programs, Wi-Fi and other machine settings are skipped." />
                            <Button Content="Restart as administrator" Command="{Binding RestartAsAdminCommand}" HorizontalAlignment="Left" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                        <TextBlock Text="{Binding Version}" Style="{StaticResource Caption}" />
                        <Button Content="Log" Style="{StaticResource LinkButton}" Command="{Binding OpenLogCommand}" FontSize="12" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Pill" CornerRadius="6" Padding="10,0" Height="36" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xEA3A;" FontSize="12" Width="24"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Name="Label" Text="{Binding Name}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xEA3B;" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Page: title, error, content, buttons. -->
        <Grid Grid.Column="1" Margin="40,30,36,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="{Binding Current.Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Current.Subtitle}" Style="{StaticResource Muted}" MaxWidth="760" HorizontalAlignment="Left"
                           Visibility="{Binding Current.Subtitle, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource ErrorBar}" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,14"
                    Visibility="{Binding Current.Error, Converter={StaticResource NullToCollapsed}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,10,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding Current.Error}" Style="{StaticResource Body}" MaxWidth="690" />
                </StackPanel>
            </Border>
            <ContentControl Grid.Row="2" Content="{Binding Current}" Focusable="False" />
            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Button Content="Back" Command="{Binding Current.BackCommand}" HorizontalAlignment="Left" MinWidth="100"
                        Visibility="{Binding Current.ShowBack, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Stop" Command="{Binding Current.CancelCommand}" MinWidth="100" Margin="0,0,8,0"
                            Visibility="{Binding Current.ShowCancel, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{Binding Current.NextText}" Command="{Binding Current.NextCommand}" Style="{DynamicResource AccentButtonStyle}"
                            MinWidth="130" IsDefault="True" Visibility="{Binding Current.ShowNext, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
